        </mxCell>
        <mxCell id="C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" value="Get today&#39;s Exam Summary and&amp;nbsp;&lt;div&gt;Concierge&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;appointments from Snowflake&lt;/span&gt;&lt;div&gt;(Mondays also include the weekend)&lt;/div&gt;&lt;/div&gt;" vertex="1">
