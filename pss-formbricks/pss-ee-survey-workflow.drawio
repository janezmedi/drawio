  <diagram id="pss-ee" name="PSS EE survey workflow">
    <mxGraphModel dx="1645" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" value="EventBridge triggers every hour&lt;br&gt;Mon-Fri, 6 AM to 5 PM CT" vertex="1">
          <mxGeometry height="60" width="260" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="ee_loader runs" vertex="1">
          <mxGeometry height="50" width="260" x="300" y="110" as="geometry" />
        </mxCell>
        <mxCell id="C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Get today&#39;s Exam Summary and Concierge appointments from Snowflake&lt;br&gt;(Mondays also include the weekend)" vertex="1">
          <mxGeometry height="70" width="260" x="300" y="190" as="geometry" />
        </mxCell>
        <mxCell id="D" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Skip appointments already tracked" vertex="1">
