        </mxCell>
        <mxCell id="E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Save new appointments to the tracking table as PENDING" vertex="1">
          <mxGeometry height="50" width="260" x="300" y="370" as="geometry" />
        </mxCell>
        <mxCell id="F" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Schedule a status check&lt;br&gt;1 hour after the appointment ends" vertex="1">
          <mxGeometry height="60" width="260" x="300" y="450" as="geometry" />
        </mxCell>
        <mxCell id="G" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="status_checker asks Elation for the appointment status" vertex="1">
          <mxGeometry height="60" width="260" x="300" y="540" as="geometry" />
        </mxCell>
        <mxCell id="H" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Cancelled, Not Seen&lt;br&gt;or deleted?" vertex="1">
          <mxGeometry height="100" width="260" x="300" y="630" as="geometry" />
        </mxCell>
        <mxCell id="X1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Skip, no survey" vertex="1">
          <mxGeometry height="50" width="200" x="640" y="655" as="geometry" />
        </mxCell>
        <mxCell id="I" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Checked Out?" vertex="1">
          <mxGeometry height="100" width="260" x="300" y="770" as="geometry" />
        </mxCell>
        <mxCell id="J" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Tried fewer than 10 times&lt;br&gt;and before 6 PM?" vertex="1">
          <mxGeometry height="100" width="240" x="620" y="770" as="geometry" />
        </mxCell>
        <mxCell id="K" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Check again in 10 minutes" vertex="1">
