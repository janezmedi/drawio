        </mxCell>
        <mxCell id="L" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Patient got this survey&lt;br&gt;in the last 3 months?" vertex="1">
          <mxGeometry height="100" width="260" x="300" y="910" as="geometry" />
        </mxCell>
