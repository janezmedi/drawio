          <mxGeometry height="150" width="260" x="1140" y="190" as="geometry" />
        </mxCell>
        <mxCell id="def-note" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#7f6000;align=left;verticalAlign=top;" value="A care gap is CREATEd when present in Snowflake (DUE) and absent in the API; CLOSEd when open in the API but no longer DUE in Snowflake. Closed gaps are never reopened." vertex="1">
          <mxGeometry height="130" width="210" x="1430" y="200" as="geometry" />
        </mxCell>
        <mxCell id="flow2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontColor=#274e13;fontSize=14;" value="Pipeline 2 — Real-time Webhook Sync  (lambdas/caregaps-sync/function.py)" vertex="1">
          <mxGeometry height="310" width="1340" x="320" y="460" as="geometry" />
        </mxCell>
        <mxCell id="apigw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D0F5;strokeColor=#9933cc;fontSize=12;verticalAlign=middle;" value="Amazon API Gateway&#xa;POST webhook endpoint" vertex="1">
