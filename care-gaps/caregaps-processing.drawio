        </mxCell>
        <mxCell id="stepfn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D0F5;strokeColor=#9933cc;fontSize=12;verticalAlign=middle;" value="AWS Step Functions&#xa;State Machine&#xa;(scheduled trigger)" vertex="1">
